{
  "name": "chappie-companion",
  "productName": "Chappie Companion",
  "version": "1.2.1",
  "description": "Share your desktop music through Chappie in Discord.",
  "author": "Vispa-Hael",
  "private": true,
  "main": "build/main.cjs",
  "scripts": { "start": "electron .", "dist": "electron-builder --win nsis --x64 --publish never" },
  "devDependencies": { "electron": "45.2.1", "electron-builder": "26.18.0" },
  "build": {
    "appId": "com.chappie.companion",
    "asar": true,
    "directories": { "output": "dist" },
    "files": ["build/main.cjs", "build/preload.cjs", "ui/**/*", "defaults.json", "package.json"],
    "extraResources": [
      { "from": "../node_modules/ffmpeg-static/ffmpeg.exe", "to": "audio/ffmpeg.exe" },
      { "from": "../node_modules/ffmpeg-static/ffmpeg.exe.LICENSE", "to": "audio/ffmpeg.exe.LICENSE" },
      { "from": "../node_modules/ffmpeg-static/ffmpeg.exe.README", "to": "audio/ffmpeg.exe.README" },
      { "from": "../node_modules/ws/LICENSE", "to": "licenses/ws-LICENSE" },
      { "from": "../tools/svcl", "to": "audio/svcl", "filter": ["**/*"] },
      { "from": "../THIRD_PARTY.md", "to": "THIRD_PARTY.md" }
    ],
    "win": { "target": ["nsis"], "artifactName": "Chappie-Companion-${version}-Setup.${ext}", "signAndEditExecutable": false },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "runAfterFinish": true, "deleteAppDataOnUninstall": false }
  }
}
