{
  "name": "discord-desktop-audio-relay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Send a selected Windows audio input into a Discord voice channel.",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "start": "tsx src/bot.ts",
    "register": "tsx src/register.ts",
    "devices": "tsx src/tools.ts devices",
    "doctor": "tsx src/tools.ts doctor",
    "check-audio": "tsx src/tools.ts check-audio",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "opusscript": "0.0.8",
    "@discordjs/voice": "0.19.2",
    "discord.js": "14.28.0",
    "dotenv": "^17.2.3",
    "ffmpeg-static": "5.3.0",
    "tsx": "4.23.15"
  },
  "devDependencies": { "@types/node": "^24.0.0", "esbuild": "0.28.2", "typescript": "^5.9.3" }
}
