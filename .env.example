# Keep the bot token private. Never paste it into a chat or commit .env.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
BOT_OWNER_ID=

# Exact RECORDING device name printed by npm run devices.
# Browser output: CABLE Input. Bot recording source: CABLE Output.
AUDIO_DEVICE="CABLE Output (VB-Audio Virtual Cable)"
DEFAULT_VOLUME=50
EMPTY_CHANNEL_TIMEOUT_SECONDS=60
# Optional: override the bundled FFmpeg with an absolute executable path.
# FFMPEG_PATH=C:\tools\ffmpeg\bin\ffmpeg.exe
